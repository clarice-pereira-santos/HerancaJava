modules = ["nodejs-24", "java-graalvm22.3", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Java: executar main.java"

[[workflows.workflow]]
name = "Java: executar main.java"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "if [ ! -s main.java ]; then echo 'main.java esta vazio. Adicione codigo Java para executar.'; exit 0; fi; mkdir -p out && javac -d out main.java $(find modelos -type f -name '*.java' -print) && java -cp out main"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
